# Скопируйте в .env и заполните реальными значениями. .env в git не попадает.

# === Обязательные ===
# Токен бота от @BotFather
BOT_TOKEN=123456:ABC-DEF...
# chat_id чата для логов и уведомлений
LOGGER_CHAT_ID=-1001234567890
# Секрет вебхука (X-Telegram-Bot-Api-Secret-Token), не короче 16 символов
SECRET_TOKEN=change_me_to_random_string
# Логин и пароль basic-auth веб-панели (/tgbot/setup, /tgbot/status)
ADMIN_USER=admin
ADMIN_PASS=change_me_to_strong_password

# === Необязательные ===
# Базовый URL для вебхука и кнопок
BASE_URL=https://example.alwaysdata.net/tgbot
# Путь к файлу SQLite
DB_FILE=storage/users.db
# chat_id через запятую, где бот не работает
IGNORING_CHAT_IDS=
